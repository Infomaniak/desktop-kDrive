<Window x:Class="Infomaniak.kDrive.CustomControls.FileOpeningFailureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Infomaniak.kDrive.CustomControls"
        xmlns:converters="using:Infomaniak.kDrive.Converters"
        mc:Ignorable="d"
        Title="kDrive">

    <Border Padding="{StaticResource Infomaniak.Style.Thickness.Uniform.L}">
        <Border.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </Border.Resources>
        <StackPanel x:Name="RootPanel"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Spacing="{StaticResource Infomaniak.Style.Spacing.S}">
            <!-- Failure title -->
            <TextBlock x:Name="FailureTitleTextBlock"
                       Style="{StaticResource Infomaniak.Style.TextBlock.Title}"
                       TextWrapping="Wrap" />

            <!-- Explanation: the item can be downloaded manually from the kDrive web application -->
            <TextBlock x:Name="FailureExplanationTextBlock"
                       TextWrapping="Wrap" />

            <!-- Card identifying the item through its icon, name, and parent folder path, hidden while the identity
                 of the item is unknown (e.g. for an invalid link) -->
            <controls:FileOpeningItemCard
                Visibility="{Binding HasItemName, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Progress of the download of the item into the download folder of the user, shown while the download
                 triggered from this window is running -->
            <StackPanel x:Name="ItemDownloadProgressPanel"
                        Visibility="Collapsed"
                        Spacing="{StaticResource Infomaniak.Style.Spacing.S}">
                <ProgressBar x:Name="ItemDownloadProgressBar" />
                <TextBlock x:Name="ItemDownloadProgressTextBlock"
                           Style="{StaticResource Infomaniak.Style.TextBlock.Caption}" />
            </StackPanel>

            <!-- Error shown when the download of the item into the download folder of the user failed: the download
                 button then falls back to the kDrive web application page of the item -->
            <TextBlock x:Name="ItemDownloadErrorTextBlock"
                       Visibility="Collapsed"
                       TextWrapping="Wrap" />

            <!-- Actions: close the window, or open the kDrive web application page of the item in a browser -->
            <Grid ColumnSpacing="{StaticResource Infomaniak.Style.Spacing.S}"
                  Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        x:Name="CloseButton"
                        Click="OnCloseClicked"
                        MinHeight="40"
                        HorizontalAlignment="Stretch" />
                <Button Grid.Column="1"
                        x:Name="DownloadButton"
                        Click="OnDownloadClicked"
                        MinHeight="40"
                        HorizontalAlignment="Stretch"
                        Style="{ThemeResource AccentButtonStyle}" />
            </Grid>
        </StackPanel>
    </Border>
</Window>
