<UserControl x:Class="Infomaniak.kDrive.CustomControls.Upsell.MyKsuiteBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Infomaniak.kDrive.CustomControls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="using:Infomaniak.kDrive.Converters"
             xmlns:controls="using:Infomaniak.kDrive.CustomControls"
             xmlns:kDrive="using:Infomaniak.kDrive"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid BorderThickness="1"
          Padding="15,13,13,13"
          HorizontalAlignment="Stretch"
          CornerRadius="{StaticResource Infomaniak.Style.CornerRadius.Uniform.S}"
          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
          RowSpacing="{StaticResource Infomaniak.Style.Spacing.XXS}">
        <Grid.BorderBrush>
            <LinearGradientBrush StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="{ThemeResource Infomaniak.DS.kSuite.Gradient.lightblue}"
                              Offset="0.0" />
                <GradientStop Color="{ThemeResource Infomaniak.DS.kSuite.Gradient.darkblue}"
                              Offset="0.2" />
                <GradientStop Color="{ThemeResource Infomaniak.DS.kSuite.Gradient.purple}"
                              Offset="0.4" />
                <GradientStop Color="{ThemeResource Infomaniak.DS.kSuite.Gradient.pink}"
                              Offset="0.6" />
                <GradientStop Color="{ThemeResource Infomaniak.DS.kSuite.Gradient.orange}"
                              Offset="0.8" />
            </LinearGradientBrush>
        </Grid.BorderBrush>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <controls:SvgIcon Grid.Column="0"
                          Grid.Row="0"
                          HorizontalAlignment="Left"
                          UriString="{ThemeResource Infomaniak.Custom.Icons.logo-myksuiteplus}"
                          Height="24" />

        <TextBlock Grid.Column="0"
                   Grid.Row="1"
                   Text="{x:Bind kDrive:Localizer.Instance.GetString('myksuitePlusBannerDescription')}" />

        <Button Grid.Column="1"
                Grid.Row="0"
                Content="{x:Bind kDrive:Localizer.Instance.GetString('buttonUpgradeSubscriptionShort')}"
                Style="{ThemeResource SubtleButtonStyle}"
                Click="Button_Click" />

    </Grid>
</UserControl>
