<UserControl x:Class="Infomaniak.kDrive.CustomControls.Upsell.UpsellInfoBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:upsell="using:Infomaniak.kDrive.CustomControls.Upsell"
             xmlns:media="using:CommunityToolkit.WinUI.Media"
             xmlns:kDrive="using:Infomaniak.kDrive"
             mc:Ignorable="d">

    <Grid>
        <upsell:MyKsuiteInfoBar x:Name="MyKsuiteInfoBar"
                                x:Load="{x:Bind MyKsuiteInfoBarLoad}"
                                Drive="{x:Bind Drive, Mode=OneWay}" />
        <upsell:KsuiteInfoBar x:Name="KsuiteInfoBar"
                              x:Load="{x:Bind KsuiteInfoBarLoad}"
                              Drive="{x:Bind Drive, Mode=OneWay}" />
    </Grid>
</UserControl>