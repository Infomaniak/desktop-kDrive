<UserControl x:Class="Infomaniak.kDrive.CustomControls.FileOpeningItemCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Infomaniak.kDrive.CustomControls"
             xmlns:converters="using:Infomaniak.kDrive.Converters">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:FilePathToIconResourceKeyConverter x:Key="FilePathToIconResourceKeyConverter" />
    </UserControl.Resources>
    <!-- Card identifying an item through its icon, name, and parent folder path. The data context is the
         FileOpeningRequest of the enclosing file opening window. -->
    <Border CornerRadius="{StaticResource Infomaniak.Style.CornerRadius.Uniform.M}"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            Padding="{StaticResource Infomaniak.Style.Thickness.Uniform.M}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Infomaniak.Style.Spacing.S}">
            <controls:SvgIcon Width="40"
                              Height="40"
                              VerticalAlignment="Center"
                              ResourceKey="{Binding ItemName, Converter={StaticResource FilePathToIconResourceKeyConverter}}" />
            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Infomaniak.Style.Spacing.XXS}">
                <TextBlock Text="{Binding ItemName}"
                           Style="{StaticResource Infomaniak.Style.TextBlock.BodyStrong}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ItemPath}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasItemPath, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
