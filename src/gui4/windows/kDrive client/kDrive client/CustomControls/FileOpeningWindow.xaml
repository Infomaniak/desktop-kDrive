<Window x:Class="Infomaniak.kDrive.CustomControls.FileOpeningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Infomaniak.kDrive.CustomControls"
        xmlns:converters="using:Infomaniak.kDrive.Converters"
        mc:Ignorable="d"
        Title="kDrive">

    <Border Padding="{StaticResource Infomaniak.Style.Thickness.Uniform.L}">
        <Border.Resources>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </Border.Resources>
        <StackPanel x:Name="RootPanel"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Spacing="{StaticResource Infomaniak.Style.Spacing.S}">
            <!-- Downloading: title -->
            <TextBlock Text="{Binding TitleText}"
                       Style="{StaticResource Infomaniak.Style.TextBlock.Title}"
                       Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Waiting: explanation -->
            <TextBlock Text="{Binding Message}"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsWaitingSync, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Card identifying the item through its icon, name, and parent folder path -->
            <controls:FileOpeningItemCard
                Visibility="{Binding HasItemName, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Downloading: gauge with the cancellation cross -->
            <Grid ColumnSpacing="{StaticResource Infomaniak.Style.Spacing.S}"
                  Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             VerticalAlignment="Center"
                             Height="8"
                             Maximum="{Binding GaugeMaximum, Mode=OneWay}"
                             Value="{Binding GaugeValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                <Button Grid.Column="1"
                        x:Name="CancelGaugeButton"
                        Click="OnCancelClicked"
                        VerticalAlignment="Center"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0">
                    <FontIcon Glyph="&#xE711;"
                              FontSize="16"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
            </Grid>

            <!-- Downloading: downloaded amount -->
            <TextBlock Text="{Binding ProgressText}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding HasDownloadProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Waiting: cancellation cross -->
            <Button x:Name="CancelWaitingButton"
                    Click="OnCancelClicked"
                    HorizontalAlignment="Right"
                    Width="28"
                    Height="28"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="{Binding IsWaitingSync, Converter={StaticResource BooleanToVisibilityConverter}}">
                <FontIcon Glyph="&#xE711;"
                          FontSize="16"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </Button>
        </StackPanel>
    </Border>
</Window>
