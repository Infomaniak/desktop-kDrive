# libgpg-error's Conan package omits its pkg-config files, so gpgrt-config
# can select an older system gpg-error.pc. An explicitly empty PKG_CONFIG_LIBDIR
# makes it use PKG_CONFIG_PATH, populated by Conan's PkgConfigDeps.
[buildenv]
libgcrypt/*:PKG_CONFIG_LIBDIR=

# GCC 15 breaks some Conan Center sources: m4's gnulib does not build in C23,
# the default C standard of GCC 15, and keychain's -Werror rejects a new
# -Wuninitialized warning in its own header.
[conf]
m4/*:tools.build:cflags+=["-std=gnu17"]
keychain/*:tools.build:cxxflags+=["-Wno-error=uninitialized"]
