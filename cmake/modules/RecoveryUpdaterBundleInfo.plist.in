<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>LSUIElement</key>
    <true/>
    <key>CFBundleDevelopmentRegion</key>
    <string>English</string>
    <key>CFBundleExecutable</key>
    <string>@UPDATER_NAME@</string>
    <key>CFBundleIconFile</key>
    <string>@UPDATER_NAME@.icns</string>
    <key>CFBundleName</key>
    <string>@UPDATER_NAME@</string>
    <key>CFBundleIdentifier</key>
    <string>@UPDATER_BUNDLE_IDENTIFIER@</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleLongVersionString</key>
    <string>@UPDATER_NAME@ @KDRIVE_VERSION_STRING@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>@KDRIVE_VERSION_FULL@</string>
    <key>CFBundleShortVersionString</key>
    <string>@KDRIVE_VERSION_STRING@</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2019 @APPLICATION_VENDOR@. All rights reserved.</string>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>@MINIMUM_SYSTEM_VERSION@</string>
</dict>
</plist>
